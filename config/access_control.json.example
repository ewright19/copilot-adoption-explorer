{
  "_comment": "Copy this to config/access_control.json and fill in real values. That file is gitignored - never commit real group IDs or UPNs.",

  "adminGroupId": "",
  "_adminGroupId_comment": "Optional. Azure AD group object ID whose members get a tenant-wide view. Leave empty unless you need a non-admin IT/reporting role.",

  "adminGroupFullTenant": true,
  "_adminGroupFullTenant_comment": "When true (default), adminGroupId members see every user in the snapshot. Set to false to limit them to every leader's direct reports instead.",

  "tenantAdminRolesEnabled": true,
  "_tenantAdminRolesEnabled_comment": "When true (default), a signed-in user holding an active Entra directory role that already grants tenant-wide usage reporting - Global Administrator, Global Reader, Reports Reader, Usage Summary Reports Reader - automatically gets a full-tenant view with no configuration. Set to false to require explicit group membership even for Global Admins.",

  "extraAdminRoleTemplateIds": [],
  "_extraAdminRoleTemplateIds_comment": "Optional. Additional Entra built-in role TEMPLATE IDs (not role assignment IDs) that should also grant a full-tenant view, e.g. '29232cdf-9323-42fd-ade2-1d097af3e4de' for Exchange Administrator.",

  "leaders": [
    {
      "leaderUpn": "amber@contoso.com",
      "delegateGroupId": "00000000-0000-0000-0000-000000000000",
      "_comment": "Members of delegateGroupId can view the direct reports of amber@contoso.com, exactly as if they were Amber. Amber does not need to be listed here because a leader is authorized automatically when signing in with their own account."
    }
  ]
}
